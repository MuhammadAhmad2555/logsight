rules_version = '2';

// AppTrack security model
// - Dashboard users sign in with Firebase Auth (verified email required).
// - A project has an owner plus members (admin | viewer).
// - Apps send logs without signing in, using an ingest key. The key is the
//   document ID of projects/{pid}/ingestKeys/{key} and must be active.
//   Like PostHog's project API key, it allows writing logs and nothing else.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function projectPath(pid) {
      return /databases/$(database)/documents/projects/$(pid);
    }

    function projectData(pid) {
      return get(projectPath(pid)).data;
    }

    function isMember(pid) {
      return verified() && exists(projectPath(pid))
        && request.auth.uid in projectData(pid).memberIds;
    }

    function isAdmin(pid) {
      return isMember(pid)
        && projectData(pid).members[request.auth.uid] in ['owner', 'admin'];
    }

    function isOwner(pid) {
      return isMember(pid) && projectData(pid).ownerId == request.auth.uid;
    }

    function membersConsistent(d) {
      return d.members is map
        && d.memberIds is list
        && d.memberEmails is map
        && d.memberIds.toSet() == d.members.keys().toSet()
        && d.memberIds.size() <= 100;
    }

    // An active ingest key of project pid (doc ID = key).
    function ingestKeyOk(pid, k) {
      return k is string && k.size() >= 32 && k.size() <= 100
        && exists(/databases/$(database)/documents/projects/$(pid)/ingestKeys/$(k))
        && get(/databases/$(database)/documents/projects/$(pid)/ingestKeys/$(k)).data.active == true;
    }

    function recent(t) {
      return t is timestamp
        && t > request.time - duration.value(7, 'd')
        && t < request.time + duration.value(1, 'h');
    }

    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ---------------------------------------------------------------- projects
    match /projects/{pid} {
      allow read: if verified() && request.auth.uid in resource.data.memberIds;

      allow create: if verified()
        && request.resource.data.keys().hasOnly(
             ['name', 'ownerId', 'members', 'memberIds', 'memberEmails', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.members.keys() == [request.auth.uid]
        && request.resource.data.members[request.auth.uid] == 'owner'
        && request.resource.data.memberEmails is map
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.createdAt == request.time;

      // The owner can rename the project and manage members.
      allow update: if isOwner(pid)
        && changed().hasOnly(['name', 'members', 'memberIds', 'memberEmails'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && membersConsistent(request.resource.data)
        && request.resource.data.members[resource.data.ownerId] == 'owner'
        && !request.resource.data.members.diff(resource.data.members)
             .affectedKeys().hasAny([resource.data.ownerId]);

      // An invited user (verified email) can add themselves, with the invited role.
      allow update: if verified()
        && !(request.auth.uid in resource.data.memberIds)
        && exists(/databases/$(database)/documents/invites/$(pid + '_' + myEmail()))
        && changed().hasOnly(['members', 'memberIds', 'memberEmails'])
        && membersConsistent(request.resource.data)
        && request.resource.data.members.diff(resource.data.members)
             .affectedKeys() == [request.auth.uid].toSet()
        && request.resource.data.members[request.auth.uid] ==
             get(/databases/$(database)/documents/invites/$(pid + '_' + myEmail())).data.role
        && request.resource.data.memberEmails[request.auth.uid] == myEmail();

      // A non-owner member can leave.
      allow update: if isMember(pid)
        && resource.data.ownerId != request.auth.uid
        && changed().hasOnly(['members', 'memberIds', 'memberEmails'])
        && membersConsistent(request.resource.data)
        && request.resource.data.members.diff(resource.data.members)
             .affectedKeys() == [request.auth.uid].toSet()
        && !(request.auth.uid in request.resource.data.memberIds);

      allow delete: if isOwner(pid);

      // ------------------------------------------------------------ ingest keys
      match /ingestKeys/{key} {
        allow read: if isAdmin(pid);
        allow create: if isAdmin(pid)
          && key.size() >= 32
          && request.resource.data.keys().hasOnly(['name', 'active', 'createdAt', 'createdBy'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 60
          && request.resource.data.active is bool
          && request.resource.data.createdAt == request.time
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if isAdmin(pid)
          && changed().hasOnly(['name', 'active'])
          && request.resource.data.active is bool
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 60;
        allow delete: if isAdmin(pid);
      }

      // ----------------------------------------------------------- saved views
      match /views/{viewId} {
        allow read: if isMember(pid);
        allow create: if isMember(pid)
          && request.resource.data.keys().hasOnly(['name', 'query', 'createdBy', 'createdAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
          && request.resource.data.query is string && request.resource.data.query.size() <= 4000
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time;
        allow delete: if isMember(pid)
          && (resource.data.createdBy == request.auth.uid || isAdmin(pid));
      }

      // ------------------------------------------------------- error issues
      // Doc ID = issue fingerprint. Only the team's decisions are stored;
      // counts come from the logs.
      match /issues/{fingerprint} {
        function validIssue(d) {
          return d.keys().hasOnly(['status', 'resolvedAt', 'updatedAt', 'assigneeUid', 'assigneeEmail'])
            && (!('status' in d) || d.status in ['open', 'resolved', 'ignored'])
            && (!('resolvedAt' in d) || d.resolvedAt == null || d.resolvedAt is timestamp)
            && (!('assigneeUid' in d) || d.assigneeUid == null
                || d.assigneeUid in projectData(pid).memberIds)
            && d.updatedAt == request.time;
        }

        allow read: if isMember(pid);
        allow create, update: if isAdmin(pid) && fingerprint.size() <= 64 && validIssue(request.resource.data);
        allow delete: if isAdmin(pid);
      }

      // ------------------------------------------------------------- alerts
      // Rules are edited by admins; the alerts Cloud Function (admin access)
      // writes firing / lastCheckedAt / lastTriggeredAt / lastValue.
      match /alerts/{alertId} {
        function validAlert(d) {
          return d.keys().hasOnly(['name', 'type', 'service', 'threshold', 'windowMinutes', 'enabled',
                                   'webhookUrl', 'updatedBy', 'updatedAt',
                                   'firing', 'lastCheckedAt', 'lastTriggeredAt', 'lastValue'])
            && d.name is string && d.name.size() > 0 && d.name.size() <= 80
            && d.type in ['error_spike', 'log_volume', 'service_silent']
            && (d['service'] == null || (d['service'] is string && d['service'].size() <= 100))
            && d.threshold is int && d.threshold >= 1 && d.threshold <= 1000000
            && d.windowMinutes is int && d.windowMinutes >= 5 && d.windowMinutes <= 1440
            && d.enabled is bool
            && (d.webhookUrl == null
                || (d.webhookUrl is string && d.webhookUrl.size() <= 500 && d.webhookUrl.matches('https://.+')))
            && d.updatedBy == request.auth.uid
            && d.updatedAt == request.time;
        }

        allow read: if isMember(pid);
        allow create: if isAdmin(pid) && validAlert(request.resource.data)
          && request.resource.data.firing == false
          && !request.resource.data.keys().hasAny(['lastCheckedAt', 'lastTriggeredAt', 'lastValue']);
        allow update: if isAdmin(pid) && validAlert(request.resource.data)
          && !changed().hasAny(['firing', 'lastCheckedAt', 'lastTriggeredAt', 'lastValue']);
        allow delete: if isAdmin(pid);
      }

      match /alertEvents/{eventId} {
        allow read: if isMember(pid);
        allow write: if false;
      }

      // ------------------------------------------------------- feature flags
      // Doc ID = flag key. Apps read flags without signing in (like PostHog's
      // flag API with the public project key), so flags must not hold secrets.
      // Admins edit them.
      match /flags/{flagKey} {
        function validCondition(c) {
          return c is map
            && c.keys().hasOnly(['property', 'op', 'value'])
            && c.property is string && c.property.size() > 0 && c.property.size() <= 200
            && c.op in ['equals', 'notEquals', 'contains', 'notContains', 'greaterThan', 'lessThan',
                        'exists', 'notExists']
            && c.value is string && c.value.size() <= 500;
        }

        function validFlag(d) {
          return d.keys().hasOnly(['name', 'description', 'enabled', 'rollout', 'conditions',
                                   'updatedBy', 'updatedAt'])
            && flagKey.matches('^[a-z0-9][a-z0-9_-]{0,63}$')
            && d.name is string && d.name.size() <= 100
            && d.description is string && d.description.size() <= 500
            && d.enabled is bool
            && d.rollout is int && d.rollout >= 0 && d.rollout <= 100
            && d.conditions is list && d.conditions.size() <= 10
            && (d.conditions.size() < 1 || validCondition(d.conditions[0]))
            && (d.conditions.size() < 2 || validCondition(d.conditions[1]))
            && (d.conditions.size() < 3 || validCondition(d.conditions[2]))
            && (d.conditions.size() < 4 || validCondition(d.conditions[3]))
            && (d.conditions.size() < 5 || validCondition(d.conditions[4]))
            && (d.conditions.size() < 6 || validCondition(d.conditions[5]))
            && (d.conditions.size() < 7 || validCondition(d.conditions[6]))
            && (d.conditions.size() < 8 || validCondition(d.conditions[7]))
            && (d.conditions.size() < 9 || validCondition(d.conditions[8]))
            && (d.conditions.size() < 10 || validCondition(d.conditions[9]))
            && d.updatedBy == request.auth.uid
            && d.updatedAt == request.time;
        }

        allow read: if true;
        allow create, update: if isAdmin(pid) && validFlag(request.resource.data);
        allow delete: if isAdmin(pid);
      }

      // ---------------------------------------------------------- dashboards
      // Any member can build and edit dashboards (like PostHog); the creator
      // or an admin can delete them.
      match /dashboards/{dashboardId} {
        function validDashboard(d) {
          return d.keys().hasOnly(['name', 'description', 'tiles', 'range', 'createdBy', 'updatedAt'])
            && d.name is string && d.name.size() > 0 && d.name.size() <= 80
            && d.description is string && d.description.size() <= 500
            && d.tiles is list && d.tiles.size() <= 30
            && d.range in ['15m', '1h', '6h', '24h', '7d', '30d', '90d']
            && d.updatedAt == request.time;
        }

        allow read: if isMember(pid);
        allow create: if isMember(pid) && validDashboard(request.resource.data)
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if isMember(pid) && validDashboard(request.resource.data)
          && !changed().hasAny(['createdBy']);
        allow delete: if isAdmin(pid) || (isMember(pid) && resource.data.createdBy == request.auth.uid);
      }

      // ============================================================ ACTIVITY
      // Product events (capture/screen/identify), people and definitions.
      // Written by apps with an ingest key; read by project members.

      // -------------------------------------------------------------- events
      match /events/{eventId} {
        function optStr(d, f, max) {
          return !(f in d) || (d[f] is string && d[f].size() <= max);
        }

        function validEvent(d) {
          return d.keys().hasAll(['event', 'distinctId', 'ts', 'receivedAt', 'key'])
            && d.keys().hasOnly(['event', 'distinctId', 'ts', 'receivedAt', 'key',
                                 'sessionId', 'service', 'properties'])
            && d.event is string && d.event.size() > 0 && d.event.size() <= 200
            && d.distinctId is string && d.distinctId.size() > 0 && d.distinctId.size() <= 200
            && recent(d.ts)
            && d.receivedAt == request.time
            && ingestKeyOk(pid, d.key)
            && optStr(d, 'sessionId', 128)
            && optStr(d, 'service', 100)
            && (!('properties' in d) || (d.properties is map && d.properties.size() <= 128));
        }

        allow read: if isMember(pid);
        allow create: if validEvent(request.resource.data);
        allow update: if false;
        allow delete: if isAdmin(pid);
      }

      // -------------------------------------------------------------- people
      // Doc ID = distinct ID. Properties are merged ($set); aliases link
      // anonymous IDs to the identified user.
      match /persons/{distinctId} {
        function validPerson(d) {
          return d.keys().hasOnly(['properties', 'firstSeen', 'lastSeen', 'key', 'aliases'])
            && d.lastSeen == request.time
            && d.firstSeen is int
            && ingestKeyOk(pid, d.key)
            && (!('properties' in d) || (d.properties is map && d.properties.size() <= 200))
            && (!('aliases' in d) || (d.aliases is list && d.aliases.size() <= 50));
        }

        allow read: if isMember(pid);
        allow create: if distinctId.size() <= 200 && validPerson(request.resource.data)
          // firstSeen is epoch milliseconds, kept with Firestore's numeric
          // "minimum" transform so it never moves later.
          && request.resource.data.firstSeen > request.time.toMillis() - 7 * 24 * 3600 * 1000
          && request.resource.data.firstSeen < request.time.toMillis() + 3600 * 1000;
        allow update: if validPerson(request.resource.data)
          && request.resource.data.firstSeen <= resource.data.firstSeen;
        allow delete: if isAdmin(pid);
      }

      // ------------------------------------------------- event definitions
      // Doc ID = event name. SDKs keep lastSeen and the list of property names
      // up to date; admins add descriptions and mark events verified.
      match /eventDefs/{name} {
        function fromApp(d) {
          return d.keys().hasOnly(['lastSeen', 'key', 'properties', 'description', 'verified', 'updatedBy'])
            && d.lastSeen == request.time
            && ingestKeyOk(pid, d.key)
            && (!('properties' in d) || (d.properties is list && d.properties.size() <= 300));
        }

        function fromDashboard(d) {
          return d.keys().hasOnly(['lastSeen', 'key', 'properties', 'description', 'verified', 'updatedBy'])
            && (!('properties' in d) || (d.properties is list && d.properties.size() <= 300));
        }

        allow read: if isMember(pid);
        allow create: if name.size() <= 200 && (fromApp(request.resource.data)
          || (isMember(pid) && fromDashboard(request.resource.data)
              && request.resource.data.keys().hasOnly(['lastSeen', 'properties'])
              && request.resource.data.lastSeen == request.time));
        allow update: if (fromApp(request.resource.data)
            && !changed().hasAny(['description', 'verified', 'updatedBy']))
          || (isMember(pid) && fromDashboard(request.resource.data)
              && changed().hasOnly(['lastSeen', 'properties'])
              && request.resource.data.lastSeen == request.time)
          || (isAdmin(pid) && fromDashboard(request.resource.data)
              && changed().hasOnly(['description', 'verified', 'updatedBy'])
              && (!('description' in request.resource.data)
                  || (request.resource.data.description is string
                      && request.resource.data.description.size() <= 500))
              && (!('verified' in request.resource.data) || request.resource.data.verified is bool)
              && request.resource.data.updatedBy == request.auth.uid);
        allow delete: if isAdmin(pid);
      }

      // --------------------------------------------------------------- services
      // One doc per service.name (e.g. keyo_ios, keyo_android), so the
      // dashboard can list and switch between apps. Logging SDKs register
      // their service with the ingest key; members can register services the
      // dashboard discovers in logs. The doc ID is the service name.
      match /services/{name} {
        function keyOk(k) {
          return k is string && k.size() >= 32 && k.size() <= 100
            && exists(/databases/$(database)/documents/projects/$(pid)/ingestKeys/$(k))
            && get(/databases/$(database)/documents/projects/$(pid)/ingestKeys/$(k)).data.active == true;
        }

        function validService() {
          return name.size() > 0 && name.size() <= 100
            && request.resource.data.lastSeen == request.time
            && (
              (request.resource.data.keys().hasOnly(['lastSeen', 'key'])
                && keyOk(request.resource.data.key))
              || (request.resource.data.keys().hasOnly(['lastSeen']) && isMember(pid))
            );
        }

        allow read: if isMember(pid);
        allow create, update: if validService();
        allow delete: if isAdmin(pid);
      }

      // ------------------------------------------------------------------- logs
      match /logs/{logId} {
        function keyPath(k) {
          return /databases/$(database)/documents/projects/$(pid)/ingestKeys/$(k);
        }

        function optString(d, f, max) {
          return !(f in d) || (d[f] is string && d[f].size() <= max);
        }

        // Optional full error details; only on error/fatal logs.
        function validError(d) {
          return !('error' in d) || (
            d.severity in ['error', 'fatal']
            && d.error is map
            && d.error.size() > 0
            && d.error.keys().hasOnly(['type', 'message', 'reason', 'stack'])
            && optString(d.error, 'type', 200)
            && optString(d.error, 'message', 4000)
            && optString(d.error, 'reason', 4000)
            && optString(d.error, 'stack', 16000)
          );
        }

        function validLog(d) {
          return d.keys().hasAll(['ts', 'severity', 'message', 'service', 'key', 'receivedAt'])
            && d.keys().hasOnly(['ts', 'severity', 'message', 'service', 'key', 'receivedAt',
                                 'attributes', 'tokens', 'traceId', 'sessionId', 'userId', 'error'])
            && d.ts is timestamp
            && d.ts > request.time - duration.value(7, 'd')
            && d.ts < request.time + duration.value(1, 'h')
            && d.receivedAt == request.time
            && d.severity in ['trace', 'debug', 'info', 'warn', 'error', 'fatal']
            && d.message is string && d.message.size() <= 10000
            && d['service'] is string && d['service'].size() > 0 && d['service'].size() <= 100
            && d.key is string && d.key.size() >= 32 && d.key.size() <= 100
            && exists(keyPath(d.key))
            && get(keyPath(d.key)).data.active == true
            && (!('attributes' in d) || (d.attributes is map && d.attributes.size() <= 64))
            && (!('tokens' in d) || (d.tokens is list && d.tokens.size() <= 64))
            && optString(d, 'traceId', 128)
            && optString(d, 'sessionId', 128)
            && optString(d, 'userId', 128)
            && validError(d);
        }

        allow read: if isMember(pid);
        allow create: if validLog(request.resource.data);
        allow update: if false;
        allow delete: if isAdmin(pid);
      }
    }

    // ------------------------------------------------------------------ invites
    // ID format: {projectId}_{lowercased email}
    match /invites/{inviteId} {
      allow read: if verified()
        && (resource.data.email == myEmail() || isOwner(resource.data.projectId));
      allow create: if isOwner(request.resource.data.projectId)
        && inviteId == request.resource.data.projectId + '_' + request.resource.data.email
        && request.resource.data.keys().hasOnly(
             ['projectId', 'projectName', 'email', 'role', 'invitedBy', 'invitedByEmail', 'createdAt'])
        && request.resource.data.email is string
        && request.resource.data.email == request.resource.data.email.lower()
        && request.resource.data.email.size() <= 254
        && request.resource.data.role in ['admin', 'viewer']
        && request.resource.data.invitedBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow delete: if verified()
        && (resource.data.email == myEmail() || isOwner(resource.data.projectId));
    }
  }
}
